{
	"name": "roblox-ts-template",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"lint": "eslint src",
		"format": "prettier --check src",
		"format:fix": "prettier --write src",
		"typecheck": "tsc --noEmit",
		"compile": "rogen build -m ts && rbxtsc",
		"build": "pnpm compile && rojo build -o game.rbxl",
		"dev": "pnpm compile && concurrently -k -n rogen,ts,rojo \"rogen watch\" \"rbxtsc -w\" \"rojo serve\"",
		"deploy": "lune run deploy"
	},
	"packageManager": "pnpm@12.6.0",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rbxts/compiler-types": "3.0.0-types.0",
		"@rbxts/types": "^1.0.956",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"concurrently": "^10.0.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-roblox-ts": "^1.4.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"jiti": "^2.7.0",
		"prettier": "^3.9.9",
		"rbxts-transformer-flamework": "^1.3.2",
		"roblox-ts": "^3.0.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.0"
	},
	"dependencies": {
		"@flamework/components": "^1.3.2",
		"@flamework/core": "^1.3.2",
		"@flamework/networking": "^1.3.2",
		"@rbxts/maid": "^1.1.0",
		"@rbxts/services": "^1.6.0",
		"@rbxts/signal": "^1.1.1",
		"@rbxts/t": "^3.2.1"
	}
}
