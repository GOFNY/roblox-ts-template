{
	"name": "roblox-ts-template",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"lint": "eslint src",
		"format": "prettier --check src",
		"format:fix": "prettier --write src",
		"compile": "rbxtsc",
		"build": "pnpm compile && rojo build -o game.rbxl",
		"build:deploy": "lune run deploy-build",
		"dev": "pnpm compile && concurrently -k -n ts,rojo \"rbxtsc -w\" \"rojo serve\""
	},
	"packageManager": "pnpm@12.18.0",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rbxts/compiler-types": "3.0.0-types.0",
		"@rbxts/types": "^1.0.961",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"concurrently": "^10.0.7",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-roblox-ts": "^1.4.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"jiti": "^2.7.0",
		"prettier": "^3.9.10",
		"roblox-ts": "^3.0.0",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.72.2"
	}
}
